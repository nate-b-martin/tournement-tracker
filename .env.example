# Environment template for both supported workflows
# ==================================================
#
# Two files are involved, and both are git-ignored:
#
#   .env        Docker Compose (`docker compose up`) reads this file.
#   .env.local  Vite (`bun run dev`) and the Convex CLI read this file.
#
# Copy only the lines you need into the matching file. Never commit either one:
# this template contains placeholders, not real credentials.
#
# ONE BACKEND AT A TIME
# ---------------------
# `npx convex dev` (local backend, data in ~/.convex) and the Docker stack
# (data in the `data` volume) both bind port 3210. They also keep separate
# data stores and separate Convex env vars. Run one or the other, never both:
#   docker compose down          # before switching to `npx convex dev`
#   npx convex dev               # stop with Ctrl-C before `docker compose up`
#
# See README.md ("Self-Hosted Docker Deployment") for the full runbook.

# --- Convex client (browser) ------------------------------------------------
# Baked into the client bundle at build time for Docker (`docker compose build
# frontend`), so the URL must be reachable from the *browser*, not just from
# inside the compose network.
VITE_CONVEX_URL=http://localhost:3210

# Convex "site" origin: HTTP actions and JWKS for Convex Auth.
VITE_CONVEX_SITE_URL=http://localhost:3211

# --- Convex CLI -> self-hosted backend --------------------------------------
# Written automatically by `scripts/docker-up.sh`; set them by hand only when
# wiring the CLI to a stack you started yourself.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=<generated-by-generate_admin_key.sh>

# The Convex CLI refuses a self-hosted target while CONVEX_DEPLOYMENT is set.
# Leave it unset/commented when using the Docker backend.
# CONVEX_DEPLOYMENT=

# --- Convex Auth deployment env --------------------------------------------
# These live on the Convex deployment (per backend), not in .env.local. They are
# set by `scripts/convex-auth-env.sh` (run automatically by docker-up.sh, or
# manually via `bun run auth:env`). JWT_PRIVATE_KEY and JWKS are generated once
# and must never be committed or copied between deployments.
#
# SITE_URL is the web app origin used for auth redirects (default when unset).
SITE_URL=http://localhost:3000

# --- Docker Compose backend (`docker-compose.yml`) --------------------------
# Stable instance name, also used to derive admin keys.
INSTANCE_NAME=tournament-tracker

# Random secret that signs admin keys. Generate once and keep it stable:
#   openssl rand -hex 32
# Changing it invalidates every previously issued admin key.
INSTANCE_SECRET=<generate-a-random-value-and-keep-it-stable>

# Origins the backend advertises. The browser uses :3210 for sync and :3211
# for HTTP actions/JWKS.
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# Where the optional dashboard points (http://127.0.0.1:6791).
# NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# --- Docker Compose frontend ------------------------------------------------
# Runtime-only (not baked into the image). SSR runs inside the container, so
# the compose service name is correct here; a restart picks up changes.
# CONVEX_SSR_URL=http://convex-backend:3210

# --- Seeded admin (used by convex/seed.ts + E2E tests) ----------------------
# Pick your own values; do not reuse production credentials. The seed mutation
# currently requires an authenticated admin, so it is wired up in Phase 2.
SITE_ADMIN_EMAIL=admin@example.com
SITE_ADMIN_PASSWORD=<change-me>

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=<same-as-above-or-dedicated>

# Override the Convex function `docker-up.sh` invokes for seeding
# (`seed:seed` is the `seed` export in convex/seed.ts).
# CONVEX_SEED_FUNCTION=seed:seed

# --- Legacy Clerk (local/cloud development only) ----------------------------
# The Dockerized deployment does not use Clerk. These stay until Phase 2
# swaps the frontend to Convex Auth; ticket 11 removes them.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWT_ISSUER_DOMAIN=https://your-domain.clerk.accounts.dev
# CLERK_TEST_EMAIL=...
# CLERK_TEST_PASSWORD=...

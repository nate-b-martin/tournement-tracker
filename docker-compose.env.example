# Docker Compose environment for the self-hosted Convex backend.
# Copy this file to `.env` (next to docker-compose.yml) before `docker compose up`:
#   cp docker-compose.env.example .env
# `.env` is gitignored — do not commit real secrets.

# Random secret used to sign backend admin keys.
# Must stay the SAME across restarts / deployments, otherwise previously issued
# admin keys stop working. Each `generate_admin_key.sh` run issues a NEW key, so
# keep the key you intend to use.
# Generate with:  openssl rand -hex 32
INSTANCE_SECRET=changeme-dev-secret

# Stable instance name (also feeds admin key derivation).
INSTANCE_NAME=tournament-tracker

# Origin the browser uses to reach Convex (client sync).
CONVEX_CLOUD_ORIGIN=http://127.0.0.1:3210

# Origin of the Convex "site" proxy (HTTP actions, JWKS).
CONVEX_SITE_ORIGIN=http://127.0.0.1:3211

# Optional: where the dashboard should point. Defaults to the cloud origin.
# NEXT_PUBLIC_DEPLOYMENT_URL=http://127.0.0.1:3210

# ---------------------------------------------------------------------------
# Frontend build args (baked into the image at build time — changing them
# requires `docker compose build frontend`, not just a restart).
# ---------------------------------------------------------------------------

# Address the *browser* uses to reach Convex. Must be reachable from the host,
# not from inside the compose network, because the client bundle talks to it
# directly. Keep this in sync with CONVEX_CLOUD_ORIGIN above.
VITE_CONVEX_URL=http://localhost:3210

# Clerk publishable key (safe to publish; the secret key stays server-side).
# Leave empty for now — auth is wired up in a later phase and the app renders an
# unauthenticated shell without it.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ---------------------------------------------------------------------------
# Frontend runtime env (NOT baked into the image — a restart is enough).
# ---------------------------------------------------------------------------

# Address *server-side rendering* uses to reach Convex. This runs inside the
# frontend container, so the compose service name is correct here and
# `http://localhost:3210` would point back at the container itself. Only change
# it if the Convex instance lives outside the compose network.
# CONVEX_SSR_URL=http://convex-backend:3210
